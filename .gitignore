# ============================================================
# Local environment and secrets
# ============================================================
.env
.env.*
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Never commit real API keys or local credential dumps.
*.pem
*.key
*.crt
*.p12
*.pfx

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local databases and generated data
backend/data/
*.db
*.sqlite
*.sqlite3

# Runtime uploads should be generated locally.
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# ============================================================
# Node / frontend
# ============================================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# Logs, caches, local output
# ============================================================
*.log
logs/
tmp/
temp/
outputs/
.cache/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
.trae/
*.swp
*.swo

# ============================================================
# Docker/local volumes
# ============================================================
docker-data/
mysql-data/
