# ============================================================
# 新闻内容采编系统 - 环境配置模板
# 复制此文件为 .env 并填入你的配置
#   cp .env.example .env
# ============================================================

# ---------- MySQL 数据库配置 (Docker Compose) ----------
MYSQL_ROOT_PASSWORD=rootpass123
MYSQL_DATABASE=news_editor
MYSQL_USER=news_editor
MYSQL_PASSWORD=apppass123
MYSQL_PORT=3306

# ---------- 后端配置 ----------
# 本地开发直连 MySQL (非 Docker)
# DATABASE_URL=mysql+pymysql://news_editor:apppass123@localhost:3306/news_editor?charset=utf8mb4
# Docker Compose 内部自动使用以下格式:
# DATABASE_URL=mysql+pymysql://news_editor:apppass123@mysql:3306/news_editor?charset=utf8mb4

# 应用配置
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-random-string-in-production

# AI API 配置 (使用 SiliconFlow，请先注册获取 API Key)
# 注册地址: https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=sk-you...here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
AI_MODEL=deepseek-ai/DeepSeek-V3

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# 爬虫配置
CRAWLER_TIMEOUT=15
CRAWLER_RETRY_TIMES=2
CRAWLER_DELAY=1.0

# 日志配置
LOG_LEVEL=INFO

# ---------- 端口配置 ----------
BACKEND_PORT=8000
FRONTEND_PORT=3000
