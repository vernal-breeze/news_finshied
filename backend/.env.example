# ============================================================
# 新闻内容采编系统 - 后端环境配置模板
# 复制此文件为 .env 并填入你的配置
#   cp .env.example .env
# ============================================================

# 数据库配置 (MySQL - Docker Compose 环境下由 docker-compose.yml 注入)
DATABASE_URL=mysql+pymysql://news_editor:apppass123@localhost:3306/news_editor?charset=utf8mb4

# AI API 配置 (使用 SiliconFlow，请先注册获取 API Key)
# 注册地址: https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=sk-you...here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
AI_MODEL=deepseek-ai/DeepSeek-V3

# 应用配置
APP_NAME=新闻内容采编系统
DEBUG=true
SECRET_KEY=change-this-to-a-random-string-in-production
ENVIRONMENT=development

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# 爬虫配置
CRAWLER_TIMEOUT=15
CRAWLER_RETRY_TIMES=2
CRAWLER_DELAY=1.0
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# 日志配置
LOG_LEVEL=INFO
