# ============================================================
# NewsFinshied - backend environment example
# Copy this file to backend/.env before local development.
# Do NOT commit backend/.env or any real API keys.
# ============================================================

# ---------- Database ----------
# SQLite is easiest for a quick local demo:
# DATABASE_URL=sqlite:///./data/news_editor.db
#
# MySQL example:
DATABASE_URL=mysql+pymysql://news_editor:change-me-db-password@localhost:3306/news_editor?charset=utf8mb4

# ---------- AI provider ----------
# Fill ONE provider key locally. Keep all real keys out of Git.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT=60

# ---------- Application ----------
APP_NAME=新闻内容采编系统
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ---------- Crawler ----------
CRAWLER_TIMEOUT=20
CRAWLER_RETRY_TIMES=2
CRAWLER_DELAY=1.0
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# ---------- Logs ----------
LOG_LEVEL=INFO

